{
  "name": "wpn-agent",
  "version": "1.4.0",
  "description": "Wpn WireGuard node agent — self-bootstrapping VPN endpoint with an HTTPS control API",
  "private": true,
  "bin": {
    "wpn-agent": "bin/wpn-agent"
  },
  "scripts": {
    "start":           "node bin/wpn-agent",
    "print":           "node bin/wpn-agent --print",
    "install-service": "node bin/wpn-agent --install",
    "dev":             "node bin/wpn-agent --skip-wg",
    "test":            "node --test test/*.test.js",
    "gen:unit":        "node scripts/gen-unit.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
