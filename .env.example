# Wpn agent environment overrides — all optional.
# Copy this file to .env and adjust as needed; the agent reads it automatically
# if you source it before starting (e.g. via the systemd EnvironmentFile= directive).

# ── Control API ───────────────────────────────────────────────────────────────
# TCP port for the HTTPS control API.  Deliberately uncommon; change freely.
WPN_AGENT_PORT=44664

# ── WireGuard ─────────────────────────────────────────────────────────────────
# UDP port WireGuard listens on.
WPN_WG_PORT=51820

# ── Identity ──────────────────────────────────────────────────────────────────
# Directory where the bearer token, TLS cert, and WireGuard pubkey cache live.
WPN_AGENT_DIR=/etc/wpn-agent

# ── UDP Echo ──────────────────────────────────────────────────────────────────
# UDP port for the echo reflector (loss/jitter probe).
WPN_ECHO_PORT=44665

# ── Stealth transport (wstunnel) ──────────────────────────────────────────────
# Set to 0 to disable the stealth relay entirely.
# WPN_STEALTH=0

# Override the stealth port (default: 443, fallback: 8443).
# WPN_STEALTH_PORT=443

# ── Logging ────────────────────────────────────────────────────────────────────
# Set to 1 for newline-delimited JSON logs.
# WPN_LOG_JSON=1

# ── Security / Update ─────────────────────────────────────────────────────────
# Allow POST /update (git pull + restart).  Off by default — root RCE surface.
# WPN_ALLOW_REMOTE_UPDATE=1

# Require git verify-commit on the upstream commit before merging.
# Only meaningful when WPN_ALLOW_REMOTE_UPDATE=1.
# WPN_UPDATE_REQUIRE_SIGNED=1

# ── Test / Development ─────────────────────────────────────────────────────────
# Override the WireGuard config path (tests use a temp file).
# WPN_WG_CONF=/tmp/test-wg0.conf
